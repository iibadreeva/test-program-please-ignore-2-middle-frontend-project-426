# HTTP port (platform usually sets this in production / Docker)
PORT=3000

# PostgreSQL connection string (required)
# Local Compose DB:
# DATABASE_URL="postgresql://hexparts:hexparts@localhost:5432/pc_parts_shop"
# Managed (Neon / Supabase / etc.):
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# Optional: session JWT secret (≥ 16 chars).
# If omitted, a stable key is derived from DATABASE_URL (anyone with DATABASE_URL
# can forge sessions — set JWT_SECRET when that trade-off is unacceptable).
# JWT_SECRET="change-me-to-a-long-random-string-in-production"
