{
  "name": "pc-parts-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "seed:build": "esbuild prisma/seed.ts --bundle --platform=node --format=cjs --outfile=dist/seed.cjs --external:@prisma/client",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "tsp:compile": "tsp compile api --emit @typespec/openapi3",
    "api:types": "typed-openapi api/openapi.yaml -o src/generated/api.ts --runtime zod --format --no-include-client",
    "api:gen": "npm run tsp:compile && npm run api:types",
    "api:check": "npm run api:gen && git diff --exit-code -- api/openapi.yaml src/generated/api.ts src/generated/api.types.d.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.0.1",
    "@prisma/client": "^6.16.2",
    "@sentry/nextjs": "^10.75.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "jose": "^6.0.11",
    "lucide-react": "^0.544.0",
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@typespec/compiler": "^1.3.0",
    "@typespec/http": "^1.3.0",
    "@typespec/openapi": "^1.3.0",
    "@typespec/openapi3": "^1.3.0",
    "@typespec/rest": "^0.73.0",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.25.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.3",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typed-openapi": "^4.1.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
